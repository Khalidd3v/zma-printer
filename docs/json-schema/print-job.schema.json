{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zmapos.com/schemas/printer-agent/print-job.schema.json",
  "title": "Zma Printer Agent — Generic Print Job",
  "type": "object",
  "required": ["schema", "printer_type", "invoice"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "generic"
    },
    "printer_type": {
      "type": "string",
      "enum": ["thermal", "a4"]
    },
    "printer_name": {
      "type": "string",
      "description": "Optional exact name of an OS-installed printer. Falls back to the configured printer, then the OS default."
    },
    "copies": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "template": {
      "type": "string",
      "description": "One of thermal-standard, thermal-compact, a4-standard, a4-modern."
    },
    "store": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone_number": { "type": "string" },
        "currency": { "type": "string" },
        "currency_symbol": { "type": "string" }
      }
    },
    "invoice": {
      "type": "object",
      "required": ["invoice_number", "total_amount"],
      "additionalProperties": true,
      "properties": {
        "invoice_number": { "type": "string" },
        "payment_type": { "type": "string" },
        "customer_name": { "type": ["string", "null"] },
        "cashier_name": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "sale_date": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quantity", "sale_price"],
            "properties": {
              "product_name": { "type": "string" },
              "product_id": { "type": ["string", "number", "null"] },
              "quantity": { "type": ["number", "string"] },
              "sale_price": { "type": ["number", "string"] },
              "unit_discount": { "type": ["number", "string"] }
            }
          }
        },
        "custom_invoice": {
          "type": ["object", "null"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "quantity": { "type": ["number", "string"] },
                  "unit_price": { "type": ["number", "string"] },
                  "line_total": { "type": ["number", "string"] }
                },
                "required": ["quantity", "unit_price"]
              }
            }
          }
        },
        "shipping_amount": { "type": ["number", "string"] },
        "manual_discount": { "type": ["number", "string"] },
        "amount_paid": { "type": ["number", "string"] },
        "remaining_balance": { "type": ["number", "string"] },
        "total_amount": { "type": ["number", "string"] }
      }
    }
  }
}
